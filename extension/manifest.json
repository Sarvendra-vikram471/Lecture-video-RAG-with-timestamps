{
  "manifest_version": 3,
  "name": "Lecture RAG: Timestamps & Q&A",
  "version": "0.1.0",
  "description": "Topic chapters with short summaries and question answering with jump-to timestamps for YouTube lectures.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["sidebar.css"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Lecture RAG settings" }
}
